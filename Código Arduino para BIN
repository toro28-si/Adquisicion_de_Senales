#include <SPI.h>
#include <SD.h>
#include <LiquidCrystal_I2C.h>

const byte chipSelect = 10;

const uint16_t N = 128;               // Muestras por bloque
const uint16_t BLOQUES_MAX = 16;       // 8 × 128 = 1024 muestras
const unsigned long intervalo = 1000; // 1 kHz

uint16_t buffer[N];

LiquidCrystal_I2C lcd(0x27, 16, 2);

void setup() {
  Serial.begin(9600);

  lcd.init();
  lcd.backlight();
  lcd.print(F("Iniciando SD..."));

  pinMode(chipSelect, OUTPUT);

  if (!SD.begin(chipSelect)) {
    Serial.println(F("Error al iniciar SD"));
    lcd.clear();
    lcd.print(F("Error SD"));
    while (true);
  }

  const char nombreArchivo[] = "F050.BIN";

  // Elimina una captura anterior con el mismo nombre.
  if (SD.exists(nombreArchivo)) {
    SD.remove(nombreArchivo);
  }

  File archivo = SD.open(nombreArchivo, FILE_WRITE);

  if (!archivo) {
    Serial.println(F("Error al abrir archivo"));
    lcd.clear();
    lcd.print(F("Error archivo"));
    while (true);
  }

  lcd.clear();
  lcd.print(F("Muestreando..."));

  for (uint16_t bloque = 0; bloque < BLOQUES_MAX; bloque++) {
    unsigned long siguienteMuestra = micros();

    // Captura 128 muestras.
    for (uint16_t i = 0; i < N; i++) {
      while (micros() < siguienteMuestra) {
      }

      buffer[i] = analogRead(A0);
      siguienteMuestra += intervalo;
    }

    // Guarda el bloque en la SD: 128 × 2 = 256 bytes.
    size_t escritos = archivo.write(
      (const uint8_t*)buffer,
      sizeof(buffer)
    );

    if (escritos != sizeof(buffer)) {
      Serial.println(F("SD llena o error"));
      archivo.close();

      lcd.clear();
      lcd.print(F("Error escritura"));
      while (true);
    }
  }

  archivo.flush();
  archivo.close();

  lcd.clear();
  lcd.print(F("Captura lista"));

  Serial.println(F("1024 muestras guardadas"));
  Serial.println(F("Archivo: F050.BIN"));

  while (true);
}

void loop() {
}
