#include <SPI.h>
#include <SD.h>
#include <LiquidCrystal_I2C.h>

const byte chipSelect = 10;

const uint16_t N = 128;               // 128 muestras
const unsigned long intervalo = 200;  // 200 us = 5 kHz

uint16_t buffer[N];

LiquidCrystal_I2C lcd(0x27, 16, 2);

void setup() {
  Serial.begin(9600);

  lcd.init();
  lcd.backlight();
  lcd.print("Iniciando SD...");

  pinMode(chipSelect, OUTPUT);

  if (!SD.begin(chipSelect)) {
    Serial.println("Error al iniciar SD");
    lcd.clear();
    lcd.print("Error SD");
    while (true);
  }

  // Cámbialo para cada frecuencia del generador
  const char* nombreArchivo = "F1500.CSV";

  // Elimina una prueba anterior con el mismo nombre
  if (SD.exists(nombreArchivo)) {
    SD.remove(nombreArchivo);
  }

  File archivo = SD.open(nombreArchivo, FILE_WRITE);

  if (!archivo) {
    Serial.println("Error al abrir archivo");
    lcd.clear();
    lcd.print("Error archivo");
    while (true);
  }

  // 1. Adquiere la señal primero, sin escribir a la SD
  lcd.clear();
  lcd.print("Muestreando...");

  unsigned long siguienteMuestra = micros();

  for (uint16_t i = 0; i < N; i++) {
    while ((long)(micros() - siguienteMuestra) < 0) {
      // Esperar hasta la siguiente muestra
    }

    buffer[i] = analogRead(A0);
    siguienteMuestra += intervalo;
  }

  // 2. Convierte y guarda los datos como texto CSV
  lcd.clear();
  lcd.print("Guardando CSV...");

  archivo.println("muestra,tiempo_us,amplitud_adc");

  for (uint16_t i = 0; i < N; i++) {
    archivo.print(i);
    archivo.print(",");

    archivo.print((unsigned long)i * intervalo);
    archivo.print(",");

    archivo.println(buffer[i]);
  }

  archivo.flush();
  archivo.close();

  lcd.clear();
  lcd.print("CSV listo");

  Serial.println("256 muestras guardadas");
  Serial.println("Archivo: F050.CSV");

  while (true); // Detiene la captura
}

void loop() {
}
